{
  "name": "unfill",
  "private": true,
  "version": "0.1.0",
  "description": "Unfill rules lab (milestone 1): shared rules core and a flat 2D test board.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen": "tsx gen/cli.ts",
    "economy:sample": "tsx gen/economy/sample.ts",
    "economy:tune": "tsx gen/economy/tune.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
