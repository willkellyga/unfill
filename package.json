{
  "name": "unfill",
  "private": true,
  "version": "0.1.0",
  "description": "Unfill: a cozy 3D sand puzzle. Milestones 1-7: rules lab, board library, move economy, 3D terrarium slice, full game loop, polish (settings, color patterns, reduced motion, home-screen app), tuning with bot runs.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen": "tsx gen/cli.ts",
    "economy:sample": "tsx gen/economy/sample.ts",
    "economy:tune": "tsx gen/economy/tune.ts",
    "build:single": "ARTIFACT=1 vite build && node scripts/single-file.mjs",
    "perf": "node scripts/perf.cjs",
    "loop-check": "node scripts/loop-check.cjs",
    "offline-check": "node scripts/offline-check.cjs",
    "playtest-check": "node scripts/playtest-check.cjs",
    "orientation-check": "node scripts/orientation-check.cjs",
    "tuning:sample": "tsx gen/tuning/sample.ts",
    "tuning": "tsx gen/tuning/tune.ts",
    "tuning:calibrate": "tsx gen/tuning/calibrate.ts",
    "tuning:playtest": "tsx gen/tuning/playtest.ts",
    "lesson-check": "node scripts/lesson-check.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.186.1"
  }
}
